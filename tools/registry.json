{
  "version": 1,
  "ui_scripts": [
    "shared/vendor/floating-ui.core.min.js",
    "shared/vendor/floating-ui.dom.min.js"
  ],
  "shared_scripts": [
    "shared/vendor/d3.min.js",
    "shared/runtime/xgboost.js",
    "shared/runtime/model-adapters.js",
    "shared/runtime/policy.js",
    "shared/runtime/model.js",
    "shared/runtime/scenarios.js",
    "shared/runtime/metrics.js",
    "shared/ui/info-windows.js",
    "shared/runtime/info-metadata.js"
  ],
  "tools": [
    {
      "id": "data-lab",
      "label": "Data lab",
      "template": "tools/data-lab/template.html",
      "scripts": [
        "tools/pipeline/client.js",
        "tools/data-lab/ui.js"
      ],
      "model_ids": "all",
      "model_data_id": "dl-model-data",
      "output": "data-lab.html"
    },
    {
      "id": "model-trainer",
      "label": "Model trainer",
      "template": "tools/model-trainer/template.html",
      "scripts": [
        "tools/pipeline/client.js",
        "tools/model-trainer/ui.js"
      ],
      "model_ids": "all",
      "model_data_id": "mt-model-data",
      "output": "trainer.html"
    },
    {
      "id": "comparison",
      "label": "Model comparison",
      "template": "tools/comparison/template.html",
      "scripts": [
        "tools/pipeline/client.js",
        "tools/comparison/comparison.js",
        "tools/comparison/native-run.js",
        "tools/comparison/native-client.js",
        "tools/comparison/dataset-controls.js",
        "tools/comparison/ui.js",
        "tools/comparison/pipeline.js"
      ],
      "native_models": [
        "dyg_tami_native"
      ],
      "model_ids": "all",
      "model_data_id": "fd-model-data",
      "output": "index.html",
      "legacy_fragment": "payment-model-comparison.html"
    },
    {
      "id": "xgboost-analytics",
      "label": "XGBoost analytics",
      "template": "tools/xgboost-analytics/template.html",
      "scripts": [
        "tools/xgboost-analytics/analytics.js",
        "tools/xgboost-analytics/ui.js"
      ],
      "model_ids": [
        "xgboost"
      ],
      "model_data_id": "xa-model-data",
      "explanation": "models/xgboost-explanations.json",
      "output": "xgboost-analytics.html"
    }
  ]
}
